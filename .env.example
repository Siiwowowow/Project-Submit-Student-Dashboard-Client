# Browser-facing Express API URL. Include /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Optional server-only URL if Next.js reaches Express through a private address.
# API_BASE_URL=http://localhost:5000/api/v1

